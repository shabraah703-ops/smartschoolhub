rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "shabraah703@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Schools Collection
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || isSuperAdmin()
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    // School Memberships
    match /school_memberships/{membershipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Students
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Streams
    match /streams/{streamId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Departments
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Subjects
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Combinations
    match /combinations/{combinationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Examinations
    match /examinations/{examId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Marks
    match /marks/{markId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Fee Payments
    match /fee_payments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit logs
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Messages
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Discipline Cases
    match /discipline_cases/{caseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
